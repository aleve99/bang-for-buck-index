# Local Supabase CLI (`pnpm db:start`)
# Values are overwritten by scripts/sync-supabase-env.sh after `supabase start`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-from-supabase-status"
SUPABASE_SERVICE_ROLE_KEY="replace-from-supabase-status"

# FX sync (Frankfurter API; no key required)
FX_API_BASE="https://api.frankfurter.dev/v1"

# Secret required in the Authorization header for the FX cron route.
CRON_SECRET="dev-cron-secret"

# Local admin moderation password for /admin
ADMIN_SECRET="dev-admin-secret"
