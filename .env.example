# Local Postgres (user-owned cluster started via `pnpm db:start`)
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/purehop"

# FX sync (Frankfurter API; no key required)
FX_API_BASE="https://api.frankfurter.dev/v1"

# Secret required in the Authorization header for the FX cron route.
# Vercel Cron sends this automatically when configured as CRON_SECRET.
CRON_SECRET="dev-cron-secret"
